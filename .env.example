# Copy file này thành .env rồi điền key thật (.env đã được gitignore).
# Chỉ cần MỘT trong hai key. Có OPENAI_API_KEY thì hệ thống tự dùng OpenAI.

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Muốn ép nhà cung cấp khi có cả hai key: openai | anthropic
# LLM_PROVIDER=openai

# Model chấm bài.
#
# KHUYÊN DÙNG gpt-4.1. Đã đo trên chính bộ câu hỏi này: nó phân biệt được
# "hiểu" với "liệt kê thuộc lòng", và cho 0 điểm khi bài sai bản chất.
# gpt-4o-mini rẻ hơn ~10 lần nhưng KHÔNG phân biệt được, và từng chấm một bài
# sai kiến thức thành 51/100 — không nên dùng để chấm.
#
# Để TRỐNG thì hệ thống tự hỏi API xem key của bạn dùng được model nào rồi chọn cái mạnh nhất.
GRADER_MODEL=gpt-4.1

# Chỉ có tác dụng với Anthropic: độ sâu suy luận low | medium | high | xhigh | max
GRADER_EFFORT=medium

PORT=5173
